# Contact-form backend endpoint (optional but REQUIRED for online inquiries to be delivered).
# Example with Formspree: https://formspree.io/f/xxxxxxxx
# Any endpoint that accepts a JSON POST and returns a 2xx status will work.
PUBLIC_FORM_ENDPOINT=

# Only for services that need a public access key in the request body (e.g. Web3Forms:
# endpoint https://api.web3forms.com/submit + the access key from your Web3Forms dashboard).
# This key is public by design (it is visible in the page) — never put a private/secret key here.
PUBLIC_FORM_ACCESS_KEY=

# Optional: Google Maps embed URL (the src="" value from Share > Embed a map)
PUBLIC_MAP_EMBED_URL=

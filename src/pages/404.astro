---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found">
  <section class="section">
    <div class="container nf">
      <p class="eyebrow">Error 404</p>
      <h1>We couldn’t find that page</h1>
      <p class="lead">The page may have moved or the link may be incorrect.</p>
      <p><a class="btn btn--primary" href="/">Back to home</a> <a class="btn btn--outline" href="/contact">Contact us</a></p>
    </div>
  </section>
</Layout>
<style>.nf{padding-block:clamp(40px,8vw,100px)}.nf .btn{margin-right:10px}</style>

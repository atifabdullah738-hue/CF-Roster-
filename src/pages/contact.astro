---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import InquiryForm from '../components/InquiryForm.astro';
import PersonContact from '../components/PersonContact.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
const mapSrc = site.mapEmbedUrl;
---
<Layout title="Contact Us" description="Contact Asif Builders for a free consultation: phone numbers, WhatsApp, inquiry form and location.">
  <PageHero crumb="Contact" eyebrow="Contact us" title="Let’s talk about your home" lead="Call or message us directly, or send an inquiry. Tell us about your plot and plans and we’ll discuss the best way forward." />

  <section class="section" aria-label="Contact details and inquiry form">
    <div class="container layout">
      <aside class="info" aria-label="Contact details">
        {site.leadership.map((p) => (
          <div class="info__card reveal">
            <span class="info__icon"><Icon name="phone" size={22} /></span>
            <div>
              <p class="info__role">{p.title}</p>
              <h2>{p.name}</h2>
              <PersonContact person={p} />
            </div>
          </div>
        ))}
        <div class="info__card reveal">
          <span class="info__icon"><Icon name="pin" size={22} /></span>
          <div>
            <p class="info__role">Office address</p>
            {site.address ? (
              <address><p>{site.address.lines.join(', ')}<br />{site.address.city}</p></address>
            ) : (
              <p class="muted">Our office address will be published here soon. Until then, please call or message us to arrange a meeting or site visit.</p>
            )}
          </div>
        </div>
        {site.email && (
          <div class="info__card reveal">
            <span class="info__icon"><Icon name="mail" size={22} /></span>
            <div><p class="info__role">Email</p><a href={`mailto:${site.email}`}>{site.email}</a></div>
          </div>
        )}
        {site.hours && (
          <div class="info__card reveal">
            <span class="info__icon"><Icon name="clock" size={22} /></span>
            <div><p class="info__role">Office hours</p><p>{site.hours}</p></div>
          </div>
        )}
      </aside>
      <div id="inquiry" class="form-wrap reveal"><InquiryForm /></div>
    </div>
  </section>

  <section class="section section--cream" aria-labelledby="loc-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Location</p>
        <h2 id="loc-title">Find us</h2>
      </div>
      {mapSrc ? (
        <div class="map reveal"><iframe title="Asif Builders office location map" src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>
      ) : (
        <div class="map map--empty reveal">
          <Icon name="pin" size={40} />
          <h3>Map coming soon</h3>
          <p>{site.address ? `${site.address.lines.join(', ')}, ${site.address.city}` : 'Our business address and map will be added here once confirmed.'}</p>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .layout { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .info, .form-wrap { min-width: 0; }
  .info { display: grid; gap: 18px; }
  .info__card { display: flex; gap: 18px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-sm); }
  .info__icon { flex: none; width: 48px; height: 48px; border-radius: 14px; background: var(--navy-900); color: var(--brass); display: grid; place-items: center; }
  .info__role { margin: 0; font-size: .78rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--brass-700); }
  .info h2 { font-size: 1.4rem; margin: 2px 0 8px; }
  .info address { font-style: normal; } .info p { margin: 4px 0 0; } .muted { color: var(--muted); font-size: .96rem; }
  .form-wrap { scroll-margin-top: calc(var(--header-h) + 20px); }
  .map { border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); aspect-ratio: 4/3; background: #fff; min-width: 0; }
  @media (min-width: 800px) { .map { aspect-ratio: 16/7; } }
  .map iframe { width: 100%; height: 100%; border: 0; }
  .map--empty { aspect-ratio: auto; min-height: 260px; display: grid; place-content: center; justify-items: center; text-align: center; gap: 4px; padding: 32px; color: var(--navy-800); border: 2px dashed var(--sand); background: repeating-linear-gradient(45deg, #fff, #fff 14px, var(--cream-50) 14px, var(--cream-50) 28px); box-shadow: none; }
  .map--empty p { color: var(--muted); max-width: 46ch; margin: 0; }
  @media (max-width: 960px) { .layout { grid-template-columns: 1fr; } .form-wrap { order: -1; } }
</style>

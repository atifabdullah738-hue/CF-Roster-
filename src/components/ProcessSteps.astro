---
import { steps } from '../data/process';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<ol class:list={['steps', { 'steps--compact': compact }]}>
  {steps.map((s, i) => (
    <li class="step reveal" style={`--d:${i * 60}ms`}>
      <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <div class="step__body">
        <h3><span class="visually-hidden">Step {i + 1}: </span>{s.title}</h3>
        <p>{s.summary}</p>
        {!compact && <ul>{s.points.map((p) => <li>{p}</li>)}</ul>}
      </div>
    </li>
  ))}
</ol>
<style>
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; counter-reset: step; position: relative; }
  .step { display: grid; grid-template-columns: 76px 1fr; gap: 22px; padding-bottom: 38px; position: relative; }
  .step:not(:last-child)::before { content: ''; position: absolute; left: 37px; top: 70px; bottom: 6px; width: 2px; background: repeating-linear-gradient(to bottom, var(--brass) 0 6px, transparent 6px 12px); }
  .step__num { width: 76px; height: 76px; border-radius: 50%; display: grid; place-items: center; background: var(--navy-900); color: var(--brass); font-family: var(--font-display); font-weight: 600; font-size: 1.6rem; box-shadow: 0 0 0 6px var(--cream); position: relative; z-index: 1; }
  .step__body { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 24px 28px; box-shadow: var(--shadow-sm); }
  .step__body h3 { margin-bottom: 6px; } .step__body p { color: var(--muted); margin-bottom: .6em; }
  .step__body ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .step__body li { position: relative; padding-left: 26px; font-size: .97rem; }
  .step__body li::before { content: ''; position: absolute; left: 4px; top: .55em; width: 10px; height: 6px; border-left: 2.5px solid var(--brass-600); border-bottom: 2.5px solid var(--brass-600); transform: rotate(-45deg) translateY(-50%); }
  /* compact variant: horizontal cards */
  .steps--compact { grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 18px; }
  .steps--compact .step { display: block; padding: 0; }
  .steps--compact .step::before { display: none; }
  .steps--compact .step__num { width: 52px; height: 52px; font-size: 1.15rem; margin-bottom: -26px; margin-left: 20px; box-shadow: 0 0 0 5px var(--cream-50); }
  .section--cream .steps--compact .step__num { box-shadow: 0 0 0 5px var(--cream); }
  .steps--compact .step__body { padding: 40px 22px 22px; height: 100%; }
  .steps--compact h3 { font-size: 1.15rem; }
  @media (max-width: 560px) { .step { grid-template-columns: 52px 1fr; gap: 14px; } .step__num { width: 52px; height: 52px; font-size: 1.1rem; } .step:not(:last-child)::before { left: 25px; top: 50px; } .step__body { padding: 18px; } .steps--compact .step { display: block; } }
</style>

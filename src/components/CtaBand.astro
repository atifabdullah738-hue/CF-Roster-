---
import { vp } from '../data/site';
import { telHref, waHref } from '../lib/contact';
import Icon from './Icon.astro';
interface Props { title?: string; text?: string }
const { title = 'Ready to build your home?', text = 'Tell us about your plot and plans — we will get back to you to discuss your project and next steps.' } = Astro.props;
const tel = telHref(vp);
const wa = waHref(vp, 'Assalam o Alaikum, I would like a free consultation with Asif Builders.');
---
<section class="cta" aria-labelledby="cta-title">
  <div class="container cta__in">
    <div>
      <h2 id="cta-title">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta__btns">
      <a class="btn btn--primary" href="/contact#inquiry">Get a Free Consultation <Icon name="arrow" /></a>
      {tel && <a class="btn btn--light" href={tel}><Icon name="phone" /> Call {vp.name.split(' ')[0]}</a>}
      {wa && <a class="btn btn--wa" href={wa} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> WhatsApp</a>}
    </div>
  </div>
</section>
<style>
  .cta { background: linear-gradient(120deg, var(--navy-900), var(--navy-700)); color: #fff; position: relative; overflow: hidden; }
  .cta::after { content: ''; position: absolute; right: -80px; top: -80px; width: 320px; height: 320px; border: 2px solid rgb(201 162 75 / .35); border-radius: 50%; box-shadow: 0 0 0 40px rgb(201 162 75 / .06); }
  .cta__in { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; gap: 28px 40px; flex-wrap: wrap; padding-block: clamp(44px, 6vw, 72px); }
  .cta h2 { color: #fff; margin-bottom: 8px; } .cta p { margin: 0; color: #c3ccd9; max-width: 54ch; }
  .cta__btns { display: flex; flex-wrap: wrap; gap: 12px; }
</style>

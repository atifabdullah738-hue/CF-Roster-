---
import { site } from '../data/site';
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<span class:list={['logo', { 'logo--light': light }]}>
  <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <rect width="48" height="48" rx="11" fill="#0f2238" />
    <path d="M9 37V22.5L24 10l15 12.5V37" fill="none" stroke="#c9a24b" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" />
    <path d="M17.5 37L24 18.5 30.5 37M20 30.5h8" fill="none" stroke="#f4efe6" stroke-width="2.8" stroke-linejoin="round" stroke-linecap="round" />
  </svg>
  <span class="logo__text">
    <span class="logo__name">{site.name}</span>
    <span class="logo__sub">Builders &amp; Developers</span>
  </span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; }
  .logo__mark { width: 46px; height: 46px; flex: none; }
  .logo__text { display: flex; flex-direction: column; line-height: 1.1; }
  .logo__name { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; color: var(--navy-900); letter-spacing: -.01em; }
  .logo__sub { font-size: .66rem; letter-spacing: .22em; text-transform: uppercase; color: var(--brass-700); font-weight: 600; margin-top: 3px; }
  .logo--light .logo__name { color: #fff; }
  .logo--light .logo__sub { color: var(--brass); }
</style>

---
import { whatsappContact, waHref } from '../lib/contact';
import Icon from './Icon.astro';
const p = whatsappContact();
const href = p ? waHref(p, 'Assalam o Alaikum, I would like a free consultation with Asif Builders.') : null;
---
{href && (
  <a class="wa-float" href={href} target="_blank" rel="noopener noreferrer" aria-label={`Chat with ${p!.name} on WhatsApp`}>
    <Icon name="whatsapp" size={30} /><span>Chat on WhatsApp</span>
  </a>
)}
<style>
  .wa-float { position: fixed; right: 18px; bottom: 18px; z-index: 90; display: inline-flex; align-items: center; gap: 10px; background: #0d7a38; color: #fff; padding: 13px 15px; border-radius: 999px; text-decoration: none; font-weight: 600; box-shadow: 0 10px 28px rgb(0 0 0 / .28); transition: transform .2s, background .2s; }
  .wa-float:hover { background: #0a6630; transform: translateY(-3px); }
  .wa-float span { max-width: 0; overflow: hidden; white-space: nowrap; transition: max-width .35s, margin .35s; }
  .wa-float:hover span, .wa-float:focus-visible span { max-width: 180px; margin-right: 6px; }
  @media (max-width: 600px) { .wa-float { right: 14px; bottom: 14px; } }
</style>

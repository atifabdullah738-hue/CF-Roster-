---
import { getImage } from 'astro:assets';
import { projects as allProjects, categories, featuredIds, type Project } from '../data/projects';
import { art, artKind, isRaster } from '../lib/images';
import ArtImage from './ArtImage.astro';
import Icon from './Icon.astro';

interface Props { featured?: boolean; filters?: boolean; id?: string }
const { featured = false, filters = true, id = 'gallery' } = Astro.props;

const list: Project[] = featured ? featuredIds.map((i) => allProjects.find((p) => p.id === i)!).filter(Boolean) : allProjects;
const items = await Promise.all(
  list.map(async (p) => {
    const meta = art(p.image);
    const raster = isRaster(meta);
    const full = raster ? (await getImage({ src: meta, width: Math.min(meta.width, 2560), format: 'webp', quality: 82 })).src : meta.src;
    // A real raster image (photo / render) automatically replaces the illustration, so its badge goes too.
    const kind = artKind(p.image); // photo | render | illustration
    return { p: { ...p, illustrative: p.illustrative && kind !== 'photo' }, kind, full };
  }),
);
// Only offer filters that actually have items.
const usedCats = categories.filter((c) => allProjects.some((p) => p.categories.includes(c)));
---
<div class="gallery" data-gallery id={id}>
  {filters && (
    <div class="filters" role="group" aria-label="Filter projects by category">
      <button type="button" class="chip is-active" data-filter="all" aria-pressed="true">All</button>
      {usedCats.map((c) => <button type="button" class="chip" data-filter={c} aria-pressed="false">{c}</button>)}
    </div>
  )}
  <p class="filter-status visually-hidden" role="status" aria-live="polite" data-status></p>
  <ul class="gallery__grid">
    {items.map(({ p, full, kind }, i) => (
      <li class="gcard reveal" style={`--d:${(i % 3) * 80}ms`} data-cats={JSON.stringify(p.categories)}>
        <button type="button" class="gcard__btn" data-full={full} data-title={p.title} data-caption={p.caption} data-alt={p.alt} data-illustrative={String(p.illustrative)} data-kind={kind}>
          <span class="gcard__media"><ArtImage name={p.image} alt={p.alt} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" /></span>
          <span class="gcard__tags">
            {p.size && <span class="tag">{p.size}</span>}
            {p.status && <span class="tag tag--status">{p.status}</span>}
          </span>
          <span class="gcard__zoom" aria-hidden="true"><Icon name="arrow" size={18} /></span>
          <span class="gcard__cap">
            <strong>{p.title}</strong>
            <span>{p.style ?? p.categories[0]}{p.location ? ` · ${p.location}` : ''}</span>
            <span class="visually-hidden">— view larger</span>
          </span>
        </button>
        {p.illustrative && <span class="gcard__ill" title={kind === 'render' ? 'Computer-generated concept render — not a photograph of a completed project' : 'Illustration — not a photograph of a completed project'}>{kind === 'render' ? 'Concept render' : 'Illustration'}</span>}
      </li>
    ))}
  </ul>
  {items.some(({ p }) => p.illustrative) && <p class="gallery__note">Images marked “Concept render” or “Illustration” are computer-generated visuals created to showcase house styles and construction stages. They are not photographs of completed Asif Builders projects and will be replaced with real project photography.</p>}
</div>

<dialog class="lightbox" aria-label="Project image viewer" data-lightbox>
  <div class="lightbox__inner">
    <button type="button" class="lb-btn lb-close" data-close aria-label="Close viewer"><Icon name="close" size={24} /></button>
    <button type="button" class="lb-btn lb-prev" data-prev aria-label="Previous image"><Icon name="chevron-left" size={28} /></button>
    <button type="button" class="lb-btn lb-next" data-next aria-label="Next image"><Icon name="chevron-right" size={28} /></button>
    <figure class="lightbox__fig">
      <img alt="" data-lb-img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" />
      <figcaption>
        <strong data-lb-title></strong>
        <span data-lb-caption></span>
        <em data-lb-ill>Computer-generated visual — not a photograph of a completed project.</em>
        <small data-lb-count></small>
      </figcaption>
    </figure>
  </div>
</dialog>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 32px; }
  .chip { font: 600 .92rem var(--font-body); padding: 10px 18px; min-height: 44px; border-radius: 999px; border: 1.5px solid var(--sand); background: #fff; color: var(--navy-900); cursor: pointer; transition: all .2s; }
  .chip:hover { border-color: var(--brass); }
  .chip.is-active { background: var(--navy-900); border-color: var(--navy-900); color: #fff; }
  .gallery__grid { list-style: none; padding: 0; margin: 0; display: grid; gap: clamp(16px, 2vw, 26px); grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .gcard { position: relative; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm); background: var(--navy-900); }
  .gcard[hidden] { display: none; }
  .gcard__btn { all: unset; display: block; position: relative; cursor: zoom-in; width: 100%; }
  .gcard__btn:focus-visible { outline: 3px solid var(--brass); outline-offset: -3px; border-radius: var(--radius-lg); }
  .gcard__media { display: block; aspect-ratio: 4 / 3; overflow: hidden; }
  .gcard__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2,.7,.2,1); }
  .gcard:hover .gcard__media :global(img) { transform: scale(1.07); }
  .gcard__cap { position: absolute; inset: auto 0 0 0; padding: 48px 18px 16px; background: linear-gradient(to top, rgb(8 20 31 / .92), rgb(8 20 31 / .0)); color: #fff; display: grid; gap: 2px; }
  .gcard__cap strong { font-family: var(--font-display); font-size: 1.12rem; font-weight: 600; line-height: 1.2; }
  .gcard__cap span { font-size: .85rem; color: #d6c28e; }
  .gcard__tags { position: absolute; top: 12px; left: 12px; display: flex; gap: 6px; }
  .tag { background: rgb(15 34 56 / .85); backdrop-filter: blur(6px); color: #fff; font-size: .74rem; font-weight: 700; letter-spacing: .06em; padding: 5px 10px; border-radius: 999px; }
  .tag--status { background: var(--brass); color: var(--navy-950); }
  .gcard__ill { position: absolute; top: 12px; right: 12px; background: rgb(255 255 255 / .9); color: var(--charcoal); font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 4px 9px; border-radius: 999px; pointer-events: none; }
  .gcard__zoom { position: absolute; right: 14px; bottom: 16px; width: 36px; height: 36px; border-radius: 50%; background: var(--brass); color: var(--navy-950); display: grid; place-items: center; opacity: 0; transform: translateY(8px); transition: all .3s; }
  .gcard:hover .gcard__zoom, .gcard__btn:focus-visible .gcard__zoom { opacity: 1; transform: none; }
  .gallery__note { margin-top: 28px; font-size: .9rem; color: var(--muted); max-width: 80ch; border-left: 3px solid var(--brass); padding-left: 14px; }

  .lightbox { border: 0; padding: 0; background: transparent; width: 100vw; height: 100vh; max-width: none; max-height: none; color: #fff; }
  .lightbox::backdrop { background: rgb(5 12 20 / .92); backdrop-filter: blur(6px); }
  .lightbox__inner { position: relative; width: 100%; height: 100%; display: grid; place-items: center; padding: 56px 64px 24px; }
  .lightbox__fig { margin: 0; display: grid; gap: 14px; max-width: min(1200px, 100%); max-height: 100%; justify-items: center; }
  .lightbox__fig img { max-width: 100%; max-height: calc(100vh - 210px); width: auto; height: auto; border-radius: 12px; box-shadow: var(--shadow-lg); background: var(--navy-800); }
  .lightbox figcaption { text-align: center; display: grid; gap: 4px; max-width: 70ch; }
  .lightbox figcaption strong { font-family: var(--font-display); font-size: 1.3rem; }
  .lightbox figcaption span { color: #c3ccd9; font-size: .95rem; }
  .lightbox figcaption em { color: var(--brass); font-size: .82rem; font-style: normal; }
  .lightbox figcaption small { color: #8fa0b6; }
  .lb-btn { position: absolute; width: 48px; height: 48px; border-radius: 50%; border: 1.5px solid rgb(255 255 255 / .4); background: rgb(255 255 255 / .08); color: #fff; display: grid; place-items: center; cursor: pointer; transition: background .2s; }
  .lb-btn:hover { background: var(--brass); color: var(--navy-950); border-color: var(--brass); }
  .lb-close { top: 14px; right: 14px; }
  .lb-prev { left: 12px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 12px; top: 50%; transform: translateY(-50%); }
  @media (max-width: 700px) {
    .lightbox__inner { padding: 60px 12px 16px; }
    .lb-prev, .lb-next { top: auto; bottom: 14px; transform: none; }
    .lb-prev { left: 14px; } .lb-next { right: 14px; }
    .lightbox__fig img { max-height: calc(100vh - 260px); }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('.gcard')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.chip')];
    const status = root.querySelector<HTMLElement>('[data-status]');
    const dlg = root.parentElement!.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const $ = (s: string) => dlg.querySelector<HTMLElement>(s)!;
    let index = 0;
    let trigger: HTMLElement | null = null;

    const visible = () => cards.filter((c) => !c.hidden);

    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter!;
        chips.forEach((c) => { const on = c === chip; c.classList.toggle('is-active', on); c.setAttribute('aria-pressed', String(on)); });
        cards.forEach((c) => {
          const show = f === 'all' || (JSON.parse(c.dataset.cats || '[]') as string[]).includes(f);
          c.hidden = !show;
          if (show) c.classList.add('is-visible');
        });
        if (status) status.textContent = `${visible().length} image${visible().length === 1 ? '' : 's'} shown for ${f === 'all' ? 'all categories' : f}.`;
      }),
    );

    const show = (i: number) => {
      const vis = visible();
      index = (i + vis.length) % vis.length;
      const b = vis[index].querySelector<HTMLButtonElement>('.gcard__btn')!;
      img.src = b.dataset.full!;
      img.alt = b.dataset.alt || '';
      $('[data-lb-title]').textContent = b.dataset.title || '';
      $('[data-lb-caption]').textContent = b.dataset.caption || '';
      $('[data-lb-ill]').hidden = b.dataset.illustrative !== 'true';
      $('[data-lb-count]').textContent = `${index + 1} / ${vis.length}`;
    };
    const open = (card: HTMLElement) => {
      trigger = card.querySelector('.gcard__btn');
      show(visible().indexOf(card));
      dlg.showModal();
      document.body.style.overflow = 'hidden';
      dlg.querySelector<HTMLElement>('[data-close]')!.focus();
    };
    const close = () => dlg.close();

    cards.forEach((c) => c.querySelector('.gcard__btn')!.addEventListener('click', () => open(c)));
    dlg.querySelector('[data-close]')!.addEventListener('click', close);
    dlg.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1));
    dlg.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).classList.contains('lightbox__inner')) close(); });
    dlg.addEventListener('close', () => { document.body.style.overflow = ''; trigger?.focus(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    // Touch swipe
    let x0 = 0;
    dlg.addEventListener('touchstart', (e) => { x0 = e.changedTouches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1)); }, { passive: true });
  });
</script>
